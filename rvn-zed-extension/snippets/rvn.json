{
  "Label": {
    "prefix": "label",
    "body": [
      "label ${1:name}",
      "    $0"
    ],
    "description": "Create an RVN label"
  },
  "Choice": {
    "prefix": "choice",
    "body": [
      "choice {",
      "    \"${1:Option}\" => {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Create an RVN choice block"
  },
  "If Else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Create an RVN conditional block"
  },
  "Dialogue": {
    "prefix": "dialogue",
    "body": [
      "${1:character} \"${2:Text}\"$0"
    ],
    "description": "Create an RVN dialogue line"
  }
}
