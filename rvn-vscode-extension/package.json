{
  "name": "rvn-language",
  "displayName": "RVN Script",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "contributes": {
    "languages": [{
      "id": "rvn",
      "extensions": [".rvn"],
      "aliases": ["RVN", "rvn"]
    }],
    "grammars": [{
      "language": "rvn",
      "scopeName": "source.rvn",
      "path": "./syntaxes/rvn.tmLanguage.json"
    }],
    "snippets": [{
      "language": "rvn",
      "path": "./snippets/rvn.snippets.json"
    }]
  }
}
