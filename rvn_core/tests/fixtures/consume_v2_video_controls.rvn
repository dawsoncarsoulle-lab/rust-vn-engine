init {set ends=0}
handler completed(event) {set ends=ends+1}
function name() {local draw=random(1,1) return "intro"}
scene label start
flow.consume_v2("scene:start","play") {capture "name"=name() video.play(__rvn_captured_v1("name"),video_clip("clip.webm",{"skippable":true,"on_end":"completed"}))}
flow.consume_v2("scene:start","pause") {capture "name"=name() video.pause(__rvn_captured_v1("name"))}
flow.consume_v2("scene:start","seek") {capture "name"=name() video.seek(__rvn_captured_v1("name"),0.5)}
flow.consume_v2("scene:start","volume") {capture "name"=name() video.volume(__rvn_captured_v1("name"),0.4)}
flow.consume_v2("scene:start","resume") {capture "name"=name() video.resume(__rvn_captured_v1("name"))}
flow.consume_v2("scene:start","skip") {capture "name"=name() video.skip(__rvn_captured_v1("name"))}
"ended"
flow.consume_v2("scene:start","stop") {capture "name"=name() video.stop(__rvn_captured_v1("name"))}
"done"
