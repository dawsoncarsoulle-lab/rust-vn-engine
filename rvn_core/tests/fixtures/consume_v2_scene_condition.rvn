function condition() {
    local draw = random(1, 1)
    return true
}
scene label start
flow.consume_v2("scene:start", "choose") {
    if condition() {
        flow.consume_v2("scene:start", "sequence") {
            flow.sequence() {
                {flow.consume_v2("scene:start", "first") {local order = 1}}
                {flow.consume_v2("scene:start", "nested") {
                    if true {
                        flow.consume_v2("scene:start", "second") {local order = order * 10 + 2}
                    } else {set bad = 1 / 0}
                }}
            }
        }
    } else {set bad = 1 / 0}
}
flow.consume_v2("scene:start", "publish") {set result = order}
