function first() {local draw=random(1,1) return 1}
function last() {local draw=random(1,1) return 3}
function collection(index) {local draw=random(1,1) return [index,index+1]}
function caller() {
    local total=0
    flow.consume_v2("function:caller","range") {
        capture "first"=first()
        capture "last"=last()
        flow.for_loop(i,__rvn_captured_v1("first"),__rvn_captured_v1("last")) {
            flow.consume_v2("function:caller","each") {
                capture "items"=collection(i)
                for item in __rvn_captured_v1("items") {
                    flow.consume_v2("function:caller","increment") {capture "draw"=random(1,1) local total=total+item}
                }
            }
        }
    }
    return total
}
scene label start
local total=0
flow.consume_v2("scene:start","range") {
    capture "first"=first()
    capture "last"=last()
    flow.for_loop(i,__rvn_captured_v1("first"),__rvn_captured_v1("last")) {
        flow.consume_v2("scene:start","each") {
            capture "items"=collection(i)
            for item in __rvn_captured_v1("items") {
                flow.consume_v2("scene:start","increment") {capture "draw"=random(1,1) local total=total+item}
            }
        }
    }
}
set result=caller()
"done"
